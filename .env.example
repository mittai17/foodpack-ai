# ---------- Database (local docker-compose Postgres by default) ----------
# See infrastructure/docker-compose.yml. For a hosted Postgres, use its
# connection string here instead.
DATABASE_URL="postgresql://foodpack:foodpack@localhost:5432/foodpack"
DIRECT_URL="postgresql://foodpack:foodpack@localhost:5432/foodpack"

# ---------- AI ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Redis / BullMQ ----------
REDIS_URL=redis://localhost:6379

# ---------- Monitoring (optional for first runnable version) ----------
SENTRY_DSN=

# ---------- API ----------
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---------- Web (Next.js, public — safe for the browser) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
